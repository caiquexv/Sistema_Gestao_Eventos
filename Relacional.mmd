    SERIE {
      bigint id PK
      varchar nome UK
    }
    ORGANIZACAO {
      bigint id PK
      varchar nome
      varchar tipo
    }
    PESSOA {
      bigint id PK
      varchar nome
      varchar email UK
    }
    ESPACO {
      bigint id PK
      varchar nome UK
      integer capacidade
    }
    RECURSO {
      bigint id PK
      varchar nome UK
    }
    EVENTO {
      bigint id PK
      bigint serie_id FK
      varchar nome
      date data_inicio
      date data_fim
    }
    ATIVIDADE {
      bigint id PK
      bigint evento_id FK
      varchar titulo
      text descricao
      varchar tipo
    }
    SESSAO {
      bigint id PK
      bigint atividade_id FK
      bigint espaco_id FK
      date data
      time hora_inicio
      time hora_fim
      interval duracao
      boolean requer_inscricao
      integer limite_vagas
    }
    ESPACO_RECURSO {
      bigint espaco_id PK,FK
      bigint recurso_id PK,FK
    }
    PROMOCAO_PESSOA {
      bigint evento_id PK,FK
      bigint pessoa_id PK,FK
    }
    PROMOCAO_ORGANIZACAO {
      bigint evento_id PK,FK
      bigint organizacao_id PK,FK
    }
    PAPEL_EVENTO {
      bigint pessoa_id PK,FK
      bigint evento_id PK,FK
      varchar papel PK
    }
    PAPEL_ATIVIDADE {
      bigint pessoa_id PK,FK
      bigint atividade_id PK,FK
      varchar papel PK
    }
    INSCRICAO_EVENTO {
      bigint pessoa_id PK,FK
      bigint evento_id PK,FK
      varchar status
      timestamp data_inscricao
    }
    INSCRICAO_SESSAO {
      bigint pessoa_id PK,FK
      bigint sessao_id PK,FK
      varchar status
      timestamp data_inscricao
    }
    HISTORICO_SESSAO {
      bigint id PK
      bigint sessao_id FK
      date data_anterior
      time hora_inicio_anterior
      time hora_fim_anterior
      bigint espaco_anterior_id FK
      date data_nova
      time hora_inicio_nova
      time hora_fim_nova
      bigint espaco_novo_id FK
      timestamp alterado_em
    }
